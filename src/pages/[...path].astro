---
import App from '../App';
import { BLOG_POSTS } from '../data/blog';
import { TEMPLATE_CATEGORIES } from '../data/categories';
import { GUIDE_ARTICLES } from '../data/guides';
import SiteLayout from '../layouts/SiteLayout.astro';
import { resolveRouteSeo } from '../utils/ssrSeo';

export function getStaticPaths() {
  const staticRoutes = [
    'create', 'canvas', 'bingo', 'premium', 'templates', 'guides', 'blog', 'about', 'contact', 'faq',
    'privacy', 'terms', 'cookies', 'disclaimer', 'accessibility', 'credits',
  ];
  const routes = [
    ...staticRoutes,
    ...TEMPLATE_CATEGORIES.map(({ path }) => path.slice(1)),
    ...GUIDE_ARTICLES.map(({ path }) => path.slice(1)),
    ...BLOG_POSTS.map(({ path }) => path.slice(1)),
  ];

  return [...new Set(routes)].map((path) => ({ params: { path } }));
}

const routePath = `/${Astro.params.path ?? ''}`;
const seo = resolveRouteSeo(routePath);
---

<SiteLayout
  title={seo.title}
  description={seo.description}
  path={routePath}
  ogType={seo.ogType}
  robots={seo.robots}
  structuredData={seo.structuredData}
>
  <App initialPath={routePath} client:load />
</SiteLayout>
