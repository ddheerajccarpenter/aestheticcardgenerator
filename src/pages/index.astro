---
import App from '../App';
import SiteLayout from '../layouts/SiteLayout.astro';
import { resolveRouteSeo } from '../utils/ssrSeo';

const seo = resolveRouteSeo('/');
---

<SiteLayout
  title={seo.title}
  description={seo.description}
  path="/"
  ogType={seo.ogType}
  robots={seo.robots}
  structuredData={seo.structuredData}
>
  <App initialPath="/" client:load />
</SiteLayout>
