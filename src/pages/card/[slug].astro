---
import App from '../../App';
import { PRESET_TEMPLATES } from '../../data/templates';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { resolveRouteSeo } from '../../utils/ssrSeo';

export function getStaticPaths() {
  return PRESET_TEMPLATES.map((t) => ({ params: { slug: t.id } }));
}

const routePath = `/card/${Astro.params.slug ?? ''}`;
const seo = resolveRouteSeo(routePath);
---

<SiteLayout
  title={seo.title}
  description={seo.description}
  path={routePath}
  ogType={seo.ogType}
  robots={seo.robots}
  structuredData={seo.structuredData}
>
  <App initialPath={routePath} client:load />
</SiteLayout>
