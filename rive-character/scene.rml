            <Fill name="Fill">
                <SolidColor colorValue="FFC69D78" name="Color"/>
            </Fill>
            <Stroke thickness="2" name="Stroke">
                <SolidColor colorValue="FF48413A" name="Color"/>
            </Stroke>
        </Shape>

        <!-- Cap Pom / Tip -->
        <Shape x="250" y="138" name="Pom" id="0:11">
            <Ellipse width="18" height="18" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill">
                <SolidColor colorValue="FFEFE6D8" name="Color"/>
            </Fill>
        </Shape>

        <!-- Left Ear -->
        <Shape x="185" y="175" name="LeftEar" id="0:12">
            <Triangle width="42" height="50" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill">
                <SolidColor colorValue="FFC69D78" name="Color"/>
            </Fill>
            <Stroke thickness="2" name="Stroke">
                <SolidColor colorValue="FF312C27" name="Color"/>
            </Stroke>
        </Shape>

        <!-- Right Ear -->
        <Shape x="315" y="175" name="RightEar" id="0:13">
            <Triangle width="42" height="50" originX="0.5" originY="0.5" name="Path"/>
            <Fill name="Fill">
                <SolidColor colorValue="FFC69D78" name="Color"/>
            </Fill>
            <Stroke thickness="2" name="Stroke">
                <SolidColor colorValue="FF312C27" name="Color"/>
            </Stroke>
        </Shape>

        <!-- Head / Body Container with floating animation -->
        <Node x="250" y="260" name="CharacterHead" id="0:20">
            <!-- Head Face -->
            <Shape name="HeadFace" id="0:21">
                <Rectangle width="175" height="155" cornerRadiusTL="75" originX="0.5" originY="0.5" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="FFEFE6D8" name="Color"/>
                </Fill>
                <Stroke thickness="3" name="Stroke">
                    <SolidColor colorValue="FF312C27" name="Color"/>
                </Stroke>
            </Shape>

            <!-- Rosy Cheeks -->
            <Shape x="-55" y="15" name="LeftCheek" id="0:22">
                <Ellipse width="24" height="14" originX="0.5" originY="0.5" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="66C69D78" name="Color"/>
                </Fill>
            </Shape>
            <Shape x="55" y="15" name="RightCheek" id="0:23">
                <Ellipse width="24" height="14" originX="0.5" originY="0.5" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="66C69D78" name="Color"/>
                </Fill>
            </Shape>

            <!-- Big Friendly Eyes -->
            <Shape x="-38" y="-10" name="LeftEye" id="0:24">
                <Ellipse width="28" height="28" originX="0.5" originY="0.5" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="FF191715" name="Color"/>
                </Fill>
            </Shape>
            <Shape x="38" y="-10" name="RightEye" id="0:25">
