                <Fill name="Fill">
                    <SolidColor colorValue="FF6F4637" name="Color"/>
                </Fill>
            </Shape>

            <!-- Archival Badge Necktie -->
            <Shape x="0" y="85" name="TieBadge" id="0:29">
