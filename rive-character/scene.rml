                <Fill name="Fill">
                    <SolidColor colorValue="FF191715" name="Color"/>
                </Fill>
            </Shape>

            <!-- Eye Highlights (Gleam) -->
            <Shape x="-33" y="-15" name="LeftHighlight" id="0:26">
                <Ellipse width="9" height="9" originX="0.5" originY="0.5" name="Path"/>
                <Fill name="Fill">
                    <SolidColor colorValue="FFFFFFFF" name="Color"/>
                </Fill>
            </Shape>
            <Shape x="43" y="-15" name="RightHighlight" id="0:27">
