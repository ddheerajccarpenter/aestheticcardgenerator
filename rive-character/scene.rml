        <!-- State Machine for Idle Breathing & Floating Animation -->
        <StateMachine name="State Machine 1" id="0:7">
            <StateMachineLayer name="Layer 1" id="0:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState>
                    <StateTransition stateToId="0:30"/>
                </EntryState>
                <AnimationState x="200" animationId="0:31" id="0:30"/>
            </StateMachineLayer>
        </StateMachine>

        <!-- Gentle Floating / Idle Animation -->
        <LinearAnimation loopValue="loop" duration="120" name="FloatIdle" id="0:31">
            <KeyedObject objectId="0:20">
                <KeyedProperty property="y">
                    <KeyFrameDouble value="260" interpolationType="linear" frame="0"/>
                    <KeyFrameDouble value="246" interpolationType="linear" frame="60"/>
                    <KeyFrameDouble value="260" interpolationType="linear" frame="120"/>
                </KeyedProperty>
                <KeyedProperty property="rotation">
                    <KeyFrameDouble value="-0.03" interpolationType="linear" frame="0"/>
                    <KeyFrameDouble value="0.03" interpolationType="linear" frame="60"/>
                    <KeyFrameDouble value="-0.03" interpolationType="linear" frame="120"/>
