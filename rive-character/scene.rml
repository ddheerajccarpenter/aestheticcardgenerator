<Rive version="1" kind="fragment">
    <!-- Archie — Aesthetic Card Generator's Archival Studio Mascot -->
    <Artboard defaultStateMachineId="0:7" styleId="0:5" width="500" height="500" name="Artboard" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <Fill name="Background">
            <SolidColor colorValue="FF191715" name="Color"/>
        </Fill>

        <!-- Studio Cap -->
        <Shape x="250" y="160" name="Cap" id="0:10">
